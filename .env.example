# Paper mode only. Never commit real credentials.
APP_ENV=development
DATABASE_PATH=trading_journal.sqlite3
TRADING_MODE=paper

# Crypto: public market data only; no API key required.
CRYPTO_EXCHANGE=binance

# Forex: OANDA practice API token for read-only candle data.
# Obtain a practice token from your OANDA account if eligible in your region.
# OANDA_API_TOKEN=
# OANDA_ACCOUNT_ID=  # optional; candle endpoint does not require it
